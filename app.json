{
  "expo": {
    "name": "VerseBite",
    "slug": "versebite",
    "version": "2.0.0",
    "orientation": "portrait",
    "scheme": "versebite",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "primaryColor": "#C9A45C",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.versebite.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.versebite.app",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F3EADB"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F3EADB",
          "dark": { "backgroundColor": "#171411" }
        }
      ]
    ]
  }
}
