{
  "expo": {
    "name": "VerseBite",
    "slug": "versebite",
    "version": "2.0.0",
    "orientation": "portrait",
    "scheme": "versebite",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.versebite.app"
    },
    "android": {
      "package": "com.versebite.app",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-notifications"
    ]
  }
}
